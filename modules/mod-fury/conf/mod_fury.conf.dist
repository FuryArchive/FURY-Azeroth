# FURY Azeroth
# First-party gameplay framework.

Fury.Enable = 1
Fury.Debug = 0

# Module-owned FURY database.
# Format: host;port_or_socket;user;password;database
FuryDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_fury"
FuryDatabase.SynchThreads = 1
Fury.Updates.EnableDatabases = 1

# Optional root containing data/sql/fury. Leave empty for the source checkout.
# Packaged installs can point this at <install>/share/fury.
Fury.Database.SourceDirectory = ""

# Throttled internal service cadences. These prevent heavy work from running on every world tick.
Fury.Tick.FastMs = 250
Fury.Tick.ServiceMs = 1000
Fury.Tick.DirectorMs = 5000
Fury.Tick.ReconcileMs = 30000

# Durable event consumers process at most this many events per consumer/service tick.
Fury.Event.ReplayBatchSize = 500

# Defias Resurgence score thresholds. The enabled score components must total 100.
# 0 <= Partial < Success <= 100; invalid ordering disables Defias scoring.
Fury.Defias.Score.PartialThreshold = 30
Fury.Defias.Score.SuccessThreshold = 70
