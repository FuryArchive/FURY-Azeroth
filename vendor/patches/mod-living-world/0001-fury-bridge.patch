diff --git a/src/invasions/RuntimeCompletionObserver.h b/src/invasions/RuntimeCompletionObserver.h
new file mode 100644
index 0000000..b73a74b
--- /dev/null
+++ b/src/invasions/RuntimeCompletionObserver.h
@@ -0,0 +1,33 @@
+#ifndef MOD_LIVING_WORLD_RUNTIME_COMPLETION_OBSERVER_H
+#define MOD_LIVING_WORLD_RUNTIME_COMPLETION_OBSERVER_H
+#include "Define.h"
+#include <functional>
+#include <utility>
+
+namespace lw
+{
+struct RuntimeCompletion
+{
+    uint64 runtimeId = 0;
+    uint32 invasionId = 0;
+    uint32 stageId = 0;
+    bool success = false;
+};
+
+// Optional external observer. Returning false defers runtime removal so a
+// durable consumer can retry. Without an observer normal standalone behavior
+// is unchanged. Delivery may repeat; consumers must be idempotent.
+class RuntimeCompletionObserver
+{
+public:
+    using Handler = std::function<bool(RuntimeCompletion const&)>;
+    void Set(Handler handler) { _handler = std::move(handler); }
+    bool Notify(RuntimeCompletion const& completion) const
+    {
+        return !_handler || _handler(completion);
+    }
+private:
+    Handler _handler;
+};
+}
+#endif

